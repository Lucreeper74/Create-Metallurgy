  "createmetallurgy.logistics.address": "Mrežna Adresa",
  "createmetallurgy.ponder.casting_blocks.header": "Lijevanje Rastopljenih Metala",
  "createmetallurgy.ponder.casting_blocks.text_1": "Blokovi za Lijevanje mogu se koristiti za hlađenje Rastopljenih Metala u specifični oblik",
  "createmetallurgy.ponder.casting_blocks.text_2": "Umivaonik za Lijevanje se koristi za lijevanje cijelog bloka",
  "createmetallurgy.ponder.casting_blocks.text_3": "Dok se Stol za Lijevanje koristi za lijevanje predmeta koristeći Grafitne Kalupe",
  "createmetallurgy.ponder.casting_blocks.text_4": "Kalupi se mogu _zaključati_ koristeći _slot za odabir načina zaključavanja_",
  "createmetallurgy.ponder.casting_blocks.text_5": "Ako koristiš lijevke dok kalup ostaje _otključan_...",
  "createmetallurgy.ponder.casting_blocks.text_6": "...možda ćeš trebati _Mjedeni Lijevak_ da ne izvučeš kalupe",
  "createmetallurgy.ponder.foundry.header": "Postavljanje Topionice",
  "createmetallurgy.ponder.foundry.text_1": "Industrijski Lonci se također mogu koristiti kao veći Umivaonik za Topionicu",
  "createmetallurgy.ponder.foundry.text_2": "Nastavke poput Mjerača možete dodavati ili uklanjati bilo kada i bilo gdje koristeći Ključ",
  "createmetallurgy.ponder.foundry.text_3": "Za topljenje metala potrebno je zagrijati Topionicu...",
  "createmetallurgy.ponder.foundry.text_4": "...Lonci moraju imati osnovnu veličinu od 5x5 blokova da bi dosegnuli maksimalnu temperaturu",
  "createmetallurgy.ponder.foundry.text_5": "Međutim, svaki blok baze bez plamenika ispod hladi Lonac. Viša temperatura znači brže topljenje!",
  "createmetallurgy.ponder.foundry.text_6": "Za razliku od Umivaonika za Topionicu, ovo je dovoljno veliko da otopi veće predmete i više njih odjednom",
  "createmetallurgy.ponder.foundry.text_7": "Trenutnu toplinu Lonaca možete provjeriti pomoću Inženjerskih Naočala i prikazuje se u Termalnim Jedinicama (Tu)",
  "createmetallurgy.ponder.foundry.text_8": "Predmeti se također mogu prenositi sa svake strane poput Predmetnog Spremnika, isto vrijedi i za tekućine kao u Spremniku Tekućine",
  "createmetallurgy.ponder.foundry.text_9": "Lonci također mogu izvoditi druge vrste recepata, poput topljenja entiteta i legiranja",
  "createmetallurgy.ponder.foundry_basin.header": "Topljenje Metala sa Umivaonikom za Topionicu",
  "createmetallurgy.ponder.foundry_basin.text_1": "Umivaonik za Topionicu je usporediv s klasičnim Umivaonikom...",
  "createmetallurgy.ponder.foundry_basin.text_2": "...Međutim, može držati samo 9 predmeta istog tipa",
  "createmetallurgy.ponder.foundry_basin.text_3": "Postavite Poklopac Topionice na vrh i vaš Umivaonik za Topionicu je sada spreman!",
  "createmetallurgy.ponder.foundry_basin.text_4": "Kao Umivaonik, Slavina može izdvojiti sastojke iz recepta...",
  "createmetallurgy.ponder.foundry_basin.text_5": "...i Tekućine sa Ispusta za Predmete",
  "createmetallurgy.ponder.foundry_basin.text_6": "Pobrini se da zatvoriš Vrh Topionice, inače recept neće početi",
  "createmetallurgy.ponder.foundry_mixer.header": "Pravljenje Legura s Mješalicom za Topionicu",
  "createmetallurgy.ponder.foundry_mixer.text_1": "Mješalica za Topionicu je slična Nehaničkom Mixeru...",
  "createmetallurgy.ponder.foundry_mixer.text_2": "...Međutim, ima puno veći utjecaj na stres",
  "createmetallurgy.ponder.foundry_mixer.text_3": "This is a test translation",
  "createmetallurgy.ponder.foundry_mixer.text_4": "Kako bi tekući metali ostali dovoljno topli...",
  "createmetallurgy.ponder.foundry_mixer.text_5": "...ti ćeš trebati Ugrijanog Gorjača Blazeova",
  "createmetallurgy.ponder.foundry_mixer.text_6": "Pobrini se da zatvoriš Vrh Topionice, inače recept neće početi",
  "createmetallurgy.ponder.foundry_mixer.text_7": "Ako koristiš Cijevi za Tekućine umjesto Ispusta za Predmete...",
  "createmetallurgy.ponder.foundry_mixer.text_8": "...Možda ćete koristiti Pametnu Cijev za Tekućine, kako biste izbjegli ispuštanje neobađenih Tekućina",
  "createmetallurgy.ponder.industrial_crucible.header": "Izradi Industrijski Topionički Lonac",
  "createmetallurgy.ponder.industrial_crucible.text_1": "Industrijski Topionički Lonci mogu se koristiti za pohranu rastopljenih metala",
  "createmetallurgy.ponder.industrial_crucible.text_2": "Možete dodati prozore pomoću Francuskog Ključa!",
  "createmetallurgy.ponder.industrial_crucible.text_3": "Topionički Lonci također mogu pohraniti više tekućina u isto vrijeme!",
  "createmetallurgy.ponder.light_bulbs.header": "Korištenje Žarulje",
  "createmetallurgy.ponder.light_bulbs.text_1": "Žarulje su alternativni izvor svjetlosti za edstone Lampu",
  "createmetallurgy.ponder.light_bulbs.text_2": "Oni emitiraju svjetlost proporcionalno snazi redstone signala koji prime",
  "createmetallurgy.ponder.light_bulbs.text_3": "Žarulje su dostupne u svim bojama",
  "createmetallurgy.ponder.light_bulbs.text_4": "Postavljanje predmeta u slot Adrese može povezati druge žarulje u mrežu",
